<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TypeScriptExecutableName Condition="'$(TypeScriptExecutableName)' == ''">tsgo-cs</TypeScriptExecutableName>
    <AssemblyName>$(TypeScriptExecutableName)</AssemblyName>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TypeScript.Compiler/TypeScript.Compiler.csproj" />
  </ItemGroup>
  <!--
    Performance-tuned GC configuration for the compiler CLI, measured on a 32-logical-processor host.
    The first pass pinned Workstation GC plus a fixed 4 MiB gen0 budget and a 1 MiB LOH threshold.
    Re-measured against the unmodified product baseline, that pinned budget cost the short-lived
    workloads 3-8% (it is a fixed per-process charge paid before Main) while it only paid off on the
    longest runs:
      * DATAS (Server GC + dynamic adaptation) instead removes those regressions: small-first-diagnostic
        -4.9%, project-references-implementation -9.4%, project-references-config -5.6%,
        tiny-files-noemit -1.5% (15 paired samples, CIs excluding 1.0) and lower peak RSS on each
        (22.1 -> 18.4 MiB, 23.0 -> 19.7 MiB, 22.7 -> 19.3 MiB).
      * Cost is confined to the single huge-file workload: +0.9% time and 175.5 -> 213.2 MiB, which is
        still better than the unmodified baseline on both counts (238 MiB, -10%).
      * A fixed gen0 budget is therefore no longer set: DATAS sizes the heap from the observed
        allocation rate, so short and long runs are no longer forced into the same shape.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="true" />
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="1" />
  </ItemGroup>
</Project>
