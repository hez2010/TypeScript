{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Launch VS Code extension",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-typescript",
                "--new-window"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/vscode-typescript/dist/**/*.js"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": "Watch for extension run"
        },
        {
            "name": "Launch C# compiler",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/built/local/tsc.dll",
            "cwd": "${workspaceFolder}",
            "args": [
                "--version"
            ],
            "preLaunchTask": "Build compiler"
        }
    ]
}
